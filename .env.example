# AWS Bedrock Configuration
AWS_REGION=
AWS_DEFAULT_REGION=
BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-7

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=



# Atlassian Remote MCP
ATLASSIAN_MCP_TRANSPORT=streamable-http
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Set your site origin. The app resolves ATLASSIAN_CLOUD_ID at startup if it is omitted.
ATLASSIAN_SITE_URL=https://replace-with-your-site.atlassian.net
# Or set ATLASSIAN_CLOUD_ID directly and omit ATLASSIAN_SITE_URL.
# ATLASSIAN_CLOUD_ID=your-cloud-id
ATLASSIAN_MCP_AUTH_TYPE=oauth2
ATLASSIAN_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Legacy static authentication options (only use if OAuth is unavailable):
# ATLASSIAN_MCP_AUTH_TYPE=bearer
# ATLASSIAN_MCP_BEARER_TOKEN=replace-with-a-valid-service-account-access-token
# ATLASSIAN_MCP_AUTH_TYPE=basic
# ATLASSIAN_MCP_EMAIL=you@example.com
# ATLASSIAN_MCP_PERSONAL_API_TOKEN=replace-with-your-personal-api-token

# Or configure a local authenticated MCP process:
# ATLASSIAN_MCP_TRANSPORT=stdio
# ATLASSIAN_MCP_COMMAND=npx
# ATLASSIAN_MCP_ARGS=["-y","your-atlassian-mcp-server"]
# ATLASSIAN_MCP_ENV={}

ATLASSIAN_MCP_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ROUNDS=6
OAUTH_STORAGE_SECRET=
HF_TOKEN=
FASTEMBED_MODEL=BAAI/bge-base-en-v1.5

